__pycache__/
*.py[cod]

# User memories are local: kept in the project tree, never pushed.
.agents/memories/user/*
!.agents/memories/user/.gitkeep

# Personal agent settings.
.claude/settings.local.json
.codex/*.local.*

# Local git worktrees.
.worktrees/

# Local reports: generated output such as memory-map, may include user memories.
reports/local/*
!reports/local/.gitkeep
