# OS metadata.
.DS_Store
Thumbs.db

__pycache__/
*.py[cod]

# User memories are local: kept in the project tree, never pushed.
.agents/memories/user/*
!.agents/memories/user/.gitkeep

# Personal agent settings.
.claude/settings.local.json
.codex/*.local.*

# Local git worktrees.
.worktrees/

# Reports are local working output; only the category folders are tracked.
# Put anything the team should keep in docs/.
reports/*
!reports/*/
reports/*/*
!reports/*/.gitkeep
