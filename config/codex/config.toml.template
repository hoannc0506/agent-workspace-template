# Generated by scripts/install-agent-settings. Do not edit the generated copy.
approvals_reviewer = "auto_review"
model = "gpt-5.6-terra"
model_reasoning_effort = "medium"

[tui]
status_line = ["model-with-reasoning", "git-branch", "context-remaining", "five-hour-limit", "project-name", "pull-request-number", "thread-title"]
status_line_use_colors = true

[features]
memories = true

# --- Secret/credential redaction (shared script with Claude Code) ---
[[hooks.UserPromptSubmit]]
[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "python3 __AGENT_SETTINGS_DIR__/hooks/redact-secrets.py"
timeout = 10

[[hooks.PostToolUse]]
[[hooks.PostToolUse.hooks]]
type = "command"
command = "python3 __AGENT_SETTINGS_DIR__/hooks/redact-secrets.py"
timeout = 15
