#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: install-agent-settings [--dry-run] [--codex-dir PATH] [--claude-dir PATH]

Generates user-level Codex and Claude Code settings from this repository.
Existing unmanaged settings are moved aside with a timestamped .backup suffix.
EOF
}

dry_run=false
codex_dir="${HOME}/.codex"
claude_dir="${HOME}/.claude"

while (($#)); do
  case "$1" in
    --dry-run) dry_run=true ;;
    --codex-dir) codex_dir="$2"; shift ;;
    --claude-dir) claude_dir="$2"; shift ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

settings_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
timestamp="$(date +%Y%m%d%H%M%S)"

render_template() {
  local template="$1"
  local destination="$2"
  local temp_file
  temp_file="$(mktemp)"

  SETTINGS_DIR="$settings_dir" TEMPLATE="$template" OUTPUT="$temp_file" python3 - <<'PY'
from pathlib import Path
import os

text = Path(os.environ["TEMPLATE"]).read_text()
text = text.replace("__AGENT_SETTINGS_DIR__", os.environ["SETTINGS_DIR"])
Path(os.environ["OUTPUT"]).write_text(text)
PY

  if [[ "$dry_run" == true ]]; then
    echo "Would write $destination from $template"
    rm -f "$temp_file"
    return
  fi

  mkdir -p "$(dirname -- "$destination")"
  if [[ -e "$destination" || -L "$destination" ]]; then
    if ! head -n 1 "$destination" 2>/dev/null | grep -Fqx '# Generated by scripts/install-agent-settings. Do not edit the generated copy.'; then
      backup="${destination}.backup.${timestamp}"
      mv -- "$destination" "$backup"
      echo "Backed up $destination to $backup"
    fi
  fi
  mv -- "$temp_file" "$destination"
  echo "Wrote $destination"
}

render_template "$settings_dir/config/codex/config.toml.template" "$codex_dir/config.toml"

if [[ -f "$codex_dir/config.local.toml" ]]; then
  if [[ "$dry_run" == true ]]; then
    echo "Would append $codex_dir/config.local.toml to $codex_dir/config.toml"
  else
    printf '\n# Per-machine overrides from config.local.toml\n' >> "$codex_dir/config.toml"
    cat "$codex_dir/config.local.toml" >> "$codex_dir/config.toml"
  fi
fi

render_template "$settings_dir/config/claude/settings.json.template" "$claude_dir/settings.json"
