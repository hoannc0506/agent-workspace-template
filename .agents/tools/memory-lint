#!/usr/bin/env python3
"""Validate agent memories (.agents/memories), the memory index (.agents/MEMORY.md)
and reports (reports/).

Usage:
  memory-lint            check every memory, the index and every report
  memory-lint PATH...    check only these files (other memories are still loaded
                         for name uniqueness and [[link]] checks; the index is
                         checked when any memory or the index is among them)

Exits 1 when any error is found; warnings never fail.
The hooks in .agents/hooks import this file, so keep it standard library only.
"""
import datetime
import importlib.util
import re
import subprocess
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
MEMORIES = ROOT / ".agents" / "memories"
INDEX = ROOT / ".agents" / "MEMORY.md"
REPORTS = ROOT / "reports"  # gitignored except the category .gitkeep files
LOCAL_REPORTS = REPORTS / "local"  # generated output such as memory-map; not linted
DOCS = ROOT / "docs"

TYPES = ("user", "feedback", "project", "reference")
FIELDS = ("name", "description", "type", "tags", "update_at")
NEEDS_WHY = ("feedback", "project")
LOCAL_TYPES = ("user",)
REPORT_EXTS = (".html", ".md", ".svg", ".png")
TEXT_EXTS = (".html", ".md", ".svg")

SLUG = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
DATE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
TAG = re.compile(r"^[a-z0-9][a-z0-9._/:-]*$")
REPORT_NAME = re.compile(r"^\d{4}-\d{2}-\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*\.[a-z]+$")
LINK = re.compile(r"\[\[([^\]]+)\]\]")
MAX_DESCRIPTION = 200
MAX_TAGS = 5


def _load_secret_patterns():
    path = ROOT / ".agents" / "hooks" / "redact-secrets.py"
    loader = SourceFileLoader("redact_secrets", str(path))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module.HIGH + module.GENERIC


SECRET_PATTERNS = _load_secret_patterns()


class Memory:
    def __init__(self, path):
        self.path = path
        self.rel = path.relative_to(ROOT).as_posix()
        self.folder = path.parent.name if path.parent.parent == MEMORIES else None
        self.fields = {}
        self.body = ""
        self.body_line = 1
        self.text = ""
        self.parse_error = None
        try:
            self.text = path.read_text(encoding="utf-8")
            self.fields, self.body, self.body_line = parse_header(self.text)
        except (OSError, UnicodeDecodeError, ValueError) as e:
            self.parse_error = str(e)

    @property
    def name(self):
        value = self.fields.get("name")
        return value if isinstance(value, str) else None

    @property
    def local(self):
        return self.folder in LOCAL_TYPES


def _scalar(value):
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def parse_header(text):
    """Parse the `---` header block. Supports `key: value`, `key: [a, b]` and
    `key:` followed by `- item` lines. Returns (fields, body, body_start_line)."""
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        raise ValueError("line 1: file must start with a '---' header block")
    end = next((i for i in range(1, len(lines)) if lines[i].strip() == "---"), None)
    if end is None:
        raise ValueError("header block is not closed with '---'")
    fields = {}
    i = 1
    while i < end:
        line = lines[i]
        if not line.strip():
            i += 1
            continue
        m = re.match(r"^([A-Za-z_][\w-]*):(?:\s+(.*))?$", line)
        if not m:
            raise ValueError(f"line {i + 1}: expected 'key: value' in header")
        key, value = m.group(1), (m.group(2) or "").strip()
        if key in fields:
            raise ValueError(f"line {i + 1}: duplicate header field '{key}'")
        i += 1
        if not value:
            items = []
            while i < end and re.match(r"^\s*-\s+", lines[i]):
                items.append(_scalar(re.sub(r"^\s*-\s+", "", lines[i])))
                i += 1
            fields[key] = items
        elif value.startswith("["):
            if not value.endswith("]"):
                raise ValueError(f"line {i}: list for '{key}' is not closed with ']'")
            inner = value[1:-1].strip()
            fields[key] = [_scalar(x) for x in inner.split(",")] if inner else []
        else:
            fields[key] = _scalar(value)
    return fields, "\n".join(lines[end + 1:]), end + 2


def memory_files():
    if not MEMORIES.is_dir():
        return []
    return sorted(p for p in MEMORIES.rglob("*") if p.is_file() and p.name != ".gitkeep")


def report_files():
    if not REPORTS.is_dir():
        return []
    return sorted(p for p in REPORTS.rglob("*")
                  if p.is_file() and p.name != ".gitkeep" and LOCAL_REPORTS not in p.parents)


def load_memories():
    return [Memory(p) for p in memory_files() if p.suffix == ".md"]


def _line_of(text, offset):
    return text.count("\n", 0, offset) + 1


def _secret_hits(text):
    hits = []
    for kind, rx in SECRET_PATTERNS:
        for m in rx.finditer(text):
            hits.append((_line_of(text, m.start()), kind))
    return sorted(set(hits))


class Report:
    def __init__(self):
        self.errors = []
        self.warnings = []

    def error(self, rel, line, msg):
        self.errors.append(f"{rel}:{line}: error: {msg}")

    def warn(self, rel, line, msg):
        self.warnings.append(f"{rel}:{line}: warning: {msg}")


def check_memory(mem, names, all_names, out):
    rel = mem.rel
    if mem.path.parent.parent != MEMORIES or mem.folder not in TYPES:
        out.error(rel, 1, f"memories must live in .agents/memories/<type>/ with type one of {', '.join(TYPES)}")
        return
    if mem.parse_error:
        out.error(rel, 1, mem.parse_error)
        return
    f = mem.fields
    missing = [k for k in FIELDS if k not in f]
    extra = [k for k in f if k not in FIELDS]
    if missing:
        out.error(rel, 1, f"missing header field(s): {', '.join(missing)}")
    if extra:
        out.error(rel, 1, f"unknown header field(s): {', '.join(extra)} (allowed: {', '.join(FIELDS)})")

    name = f.get("name")
    if "name" in f:
        if not isinstance(name, str) or not SLUG.match(name):
            out.error(rel, 1, "name must be a kebab-case slug (a-z, 0-9, '-')")
        elif name != mem.path.stem:
            out.error(rel, 1, f"name '{name}' must equal the filename '{mem.path.stem}'")
        elif names.count(name) > 1:
            out.error(rel, 1, f"name '{name}' is used by more than one memory")

    desc = f.get("description")
    if "description" in f:
        if not isinstance(desc, str) or not desc.strip():
            out.error(rel, 1, "description must be a non-empty one-line string")
        elif len(desc) > MAX_DESCRIPTION:
            out.error(rel, 1, f"description is {len(desc)} chars; keep it under {MAX_DESCRIPTION}")

    typ = f.get("type")
    if "type" in f:
        if typ not in TYPES:
            out.error(rel, 1, f"type must be one of {', '.join(TYPES)}")
        elif typ != mem.folder:
            out.error(rel, 1, f"type '{typ}' does not match its folder '{mem.folder}/'")

    tags = f.get("tags")
    if "tags" in f:
        if not isinstance(tags, list) or not tags:
            out.error(rel, 1, f"tags must be a list of 1 to {MAX_TAGS} items, e.g. tags: [testing, ci]")
        else:
            if len(tags) > MAX_TAGS:
                out.error(rel, 1, f"{len(tags)} tags; use at most {MAX_TAGS}")
            bad = [t for t in tags if not TAG.match(t)]
            if bad:
                out.error(rel, 1, f"invalid tag(s) {bad}: use lowercase a-z 0-9 and . _ / : -")
            if len(set(tags)) != len(tags):
                out.error(rel, 1, "duplicate tags")
            for t in tags:
                if t.startswith("doc:") and not (DOCS / t[len("doc:"):]).is_file():
                    out.warn(rel, 1, f"tag '{t}' points to a missing file under docs/")
                if t.startswith("report:"):
                    out.error(rel, 1, f"tag '{t}': reports are local and gitignored; "
                                      "move the content to docs/ and tag it doc:<path>")

    if "update_at" in f:
        value = f.get("update_at")
        try:
            if not isinstance(value, str) or not DATE.match(value):
                raise ValueError
            day = datetime.date.fromisoformat(value)
        except ValueError:
            out.error(rel, 1, "update_at must be the last modified day as YYYY-MM-DD, e.g. update_at: 2026-10-01")
        else:
            if day > datetime.date.today():
                out.error(rel, 1, f"update_at {value} is in the future")

    if not mem.body.strip():
        out.error(rel, mem.body_line, "body is empty")
    elif mem.folder in NEEDS_WHY:
        for marker in ("**Why:**", "**How to apply:**"):
            if marker not in mem.body:
                out.error(rel, mem.body_line, f"{mem.folder} memories need a '{marker}' line")

    for m in LINK.finditer(mem.text):
        target = m.group(1).strip()
        if target not in all_names:
            out.warn(rel, _line_of(mem.text, m.start()), f"[[{target}]] does not match any memory name")

    for line, kind in _secret_hits(mem.text):
        out.error(rel, line, f"looks like a secret ({kind}); never store secrets in memories")


def build_index(memories):
    """Return the full text of .agents/MEMORY.md for the shared memories."""
    lines = [
        "# Memory index",
        "",
        "Generated by `.agents/tools/memory-index`; do not edit by hand.",
        "Regenerate it after every memory you create, update, rename or delete, in the same change.",
        "One line per shared memory: name, description, tags.",
        "Open a memory's file only when its description is relevant to the task.",
        "Local `user` memories are not listed here; read every file in `.agents/memories/user/`.",
    ]
    shared = [m for m in memories if m.folder in TYPES and m.folder not in LOCAL_TYPES]
    for typ in TYPES:
        if typ in LOCAL_TYPES:
            continue
        group = sorted((m for m in shared if m.folder == typ), key=lambda m: m.path.name)
        lines += ["", f"## {typ}", ""]
        if not group:
            lines.append("(none)")
        for m in group:
            link = f"[{m.path.stem}](memories/{typ}/{m.path.name})"
            desc = m.fields.get("description")
            tags = m.fields.get("tags")
            if m.parse_error or not isinstance(desc, str):
                lines.append(f"- {link}: (invalid header, run .agents/tools/memory-lint)")
                continue
            tag_text = f" [{', '.join(tags)}]" if isinstance(tags, list) and tags else ""
            lines.append(f"- {link}: {desc}{tag_text}")
    return "\n".join(lines) + "\n"


def check_index(memories, out):
    rel = INDEX.relative_to(ROOT).as_posix()
    try:
        current = INDEX.read_text(encoding="utf-8")
    except FileNotFoundError:
        out.error(rel, 1, "memory index is missing; run .agents/tools/memory-index")
        return
    except (OSError, UnicodeDecodeError) as e:
        out.error(rel, 1, f"cannot read memory index: {e}")
        return
    expected = build_index(memories)
    if current != expected:
        cur, exp = current.splitlines(), expected.splitlines()
        line = next((i + 1 for i, (a, b) in enumerate(zip(cur, exp)) if a != b), min(len(cur), len(exp)) + 1)
        out.error(rel, line, "memory index is out of date with .agents/memories; run .agents/tools/memory-index")


def check_report(path, out):
    rel = path.relative_to(ROOT).as_posix()
    if path.parent.parent != REPORTS:
        out.error(rel, 1, "reports must live directly in reports/<category>/")
        return
    if path.suffix not in REPORT_EXTS:
        out.error(rel, 1, f"report extension must be one of {', '.join(REPORT_EXTS)}")
    if not REPORT_NAME.match(path.name):
        out.error(rel, 1, "report name must be YYYY-MM-DD-<kebab-slug>.<ext>")
    if path.suffix in TEXT_EXTS:
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as e:
            out.error(rel, 1, f"cannot read as UTF-8 text: {e}")
            return
        for line, kind in _secret_hits(text):
            out.error(rel, line, f"looks like a secret ({kind}); never commit secrets in reports")


def check_local_not_tracked(out):
    """Local memories and reports must never be committed (catches `git add -f`)."""
    try:
        tracked = subprocess.run(
            ["git", "-C", str(ROOT), "ls-files", "--",
             *(f".agents/memories/{t}" for t in LOCAL_TYPES), "reports"],
            capture_output=True, text=True, check=True,
        ).stdout.split()
    except (OSError, subprocess.CalledProcessError):
        return
    for rel in tracked:
        if Path(rel).name != ".gitkeep":
            out.error(rel, 1, "local file is tracked by git; run `git rm --cached` on it")


def lint(paths=None):
    """Return a Report. `paths` limits per-file checks to those files."""
    out = Report()
    memories = load_memories()
    names = [m.name for m in memories if m.name]
    all_names = set(names)

    if paths is None:
        targets_mem = memories
        for p in memory_files():
            if p.suffix != ".md":
                out.error(p.relative_to(ROOT).as_posix(), 1, "memories must be .md files")
        targets_rep = report_files()
        with_index = True
    else:
        wanted = {Path(p).resolve() for p in paths}
        targets_mem = [m for m in memories if m.path in wanted]
        targets_rep = [p for p in wanted
                       if p.is_file() and REPORTS in p.parents and LOCAL_REPORTS not in p.parents]
        for p in wanted:
            if p.is_file() and MEMORIES in p.parents and p.suffix != ".md" and p.name != ".gitkeep":
                out.error(p.relative_to(ROOT).as_posix(), 1, "memories must be .md files")
        with_index = INDEX in wanted or any(MEMORIES in p.parents for p in wanted)

    for mem in targets_mem:
        check_memory(mem, names, all_names, out)
    for path in sorted(targets_rep):
        if path.name != ".gitkeep":
            check_report(path, out)
    if with_index:
        check_index(memories, out)
    check_local_not_tracked(out)
    return out


def main(argv):
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__.strip())
        return 0
    out = lint(argv or None)
    for line in out.errors + out.warnings:
        print(line)
    print(f"memory-lint: {len(out.errors)} error(s), {len(out.warnings)} warning(s)")
    return 1 if out.errors else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
